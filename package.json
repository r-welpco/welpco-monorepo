{
  "name": "welpco-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Welpco platform monorepo",
  "scripts": {
    "dev": "turbo run dev --filter=@welpco/web --filter=@welpco/bff --concurrency=2",
    "dev:pretty": "concurrently --kill-others-on-fail --prefix-colors \"bgBlue.bold,bgGreen.bold\" --prefix \"[{name}]\" --names \"WEB,BFF\" \"pnpm --filter @welpco/web dev\" \"pnpm --filter @welpco/bff dev\"",
    "dev:web": "turbo run dev --filter=@welpco/web",
    "dev:services": "turbo run dev --filter=@welpco/bff",
    "dev:admin": "turbo run dev --filter=@welpco/admin --filter=@welpco/bff --concurrency=2",
    "dev:zellij": "./scripts/dev-zellij.sh",
    "dev:docker": "docker-compose up -d",
    "dev:logs": "docker-compose logs -f",
    "setup": "./scripts/setup-dev.sh",
    "db:migrate": "pnpm --filter @welpco/bff migration:run",
    "seed:users": "pnpm --filter @welpco/bff seed",
    "clean:non-admin-users": "pnpm --filter @welpco/bff clean:non-admin-users",
    "create:admin": "pnpm --filter @welpco/bff create:admin",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=9999",
    "lint:root": "eslint . --max-warnings=9999",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky && node scripts/install-husky-hook.mjs"
  },
  "devDependencies": {
    "turbo": "^2.6.1",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "@typescript-eslint/parser": "^8.48.0",
    "@welpco/eslint-plugin-design": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": ["eslint --fix"]
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "node": "22.21.1",
    "pnpm": "9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
