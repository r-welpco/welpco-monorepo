# Welpco Monorepo Environment Variables
# Copy this file to .env.local and update with your values

# Database Configuration
DATABASE_URL=postgresql://welpco:welpco_dev@localhost:5432/welpco_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=welpco
POSTGRES_PASSWORD=welpco_dev
POSTGRES_DB=welpco_dev

# Local dev: cache is in-memory; no Kafka/OpenSearch/Redis. Backend needs only postgres (and optionally MailHog for email testing).

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-a-secure-random-string-in-production
JWT_REFRESH_EXPIRES_IN=7d

# AWS Configuration
AWS_REGION=us-east-1

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Zoho SalesIQ — web public marketing/contact chat widget
NEXT_PUBLIC_ZOHO_SALESIQ_ENABLED=false
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=
NEXT_PUBLIC_ZOHO_SALESIQ_SCRIPT_SRC=

# Application Configuration
NODE_ENV=development
API_VERSION=v1

# Service Ports (single backend + web)
WEB_PORT=8080
# Backend (BFF) runs on PORT=3000

# Logging
LOG_LEVEL=debug

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# CORS
CORS_ORIGIN=http://localhost:3000
