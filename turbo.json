{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_ZOHO_SALESIQ_ENABLED",
    "NEXT_PUBLIC_ZOHO_SALESIQ_SCRIPT_SRC",
    "NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{tsx,jsx,mdx}"]
    },
    "@welpco/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{tsx,jsx,mdx}"],
      "env": [
        "AUTH_INTERNAL_API_URL",
        "CONTACT_INBOX",
        "INTERNAL_API_URL",
        "NEXT_PUBLIC_DEFAULT_COUNTRY_CODE",
        "NEXT_PUBLIC_ENABLE_SW_IN_DEV",
        "NEXT_PUBLIC_PLATFORM_ACCESS_GATED",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "NEXT_PUBLIC_ZOHO_SALESIQ_ENABLED",
        "NEXT_PUBLIC_ZOHO_SALESIQ_SCRIPT_SRC",
        "NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE",
        "PLATFORM_ACCESS_GATED",
        "PUBLIC_APP_URL",
        "TURNSTILE_SECRET_KEY"
      ]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "//#lint:root": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
