{
  "name": "@welpco/design-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "test-storybook --ci --url http://127.0.0.1:6006",
    "test:a11y:static": "concurrently -k -s first -n SB,TEST -c magenta,blue \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:6006 && test-storybook --url http://127.0.0.1:6006\""
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "3.3.0",
    "@welpco/ui": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/react-vite": "^10.1.10",
    "@storybook/test-runner": "^0.24.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-playwright": "^2.2.2",
    "concurrently": "^9.2.1",
    "http-server": "^14.1.1",
    "storybook": "^10.1.10",
    "typescript": "^5",
    "vite": "^7.2.4",
    "wait-on": "^9.0.5"
  }
}
