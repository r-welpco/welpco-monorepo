# BFF Service Environment Variables
# Copy this file to .env.local or .env and update values as needed

# Application Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (optional in development, required in production)
# In development, if not set, automatically allows http://localhost:8080, http://localhost:8081, and http://localhost:3000
FRONTEND_URL=http://localhost:8081
# Optional: comma-separated allowlist (overrides default CORS build). Use in prod for web + admin.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Database (single backend uses one PostgreSQL database)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=welpco
DB_PASSWORD=welpco_dev
DB_DATABASE=welpco_dev

# JWT Configuration (keep JWT_REFRESH_SECRET consistent across restarts or refresh will fail with 401)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Maps Geocoding (reverse: lat/lng → address; forward: postal code → lat/lng)
# Enable "Geocoding API" in Google Cloud Console: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
# Non-empty value required at startup. Use a real Geocoding API key for address features; `local-dev-placeholder` only satisfies boot.
GOOGLE_MAPS_API_KEY=local-dev-placeholder

# Stripe (platform account — no Connect). Webhook signing secret from Dashboard → Developers → Webhooks
# API version is pinned in src/domains/payment/stripe-client.ts (bump with Stripe SDK releases).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
