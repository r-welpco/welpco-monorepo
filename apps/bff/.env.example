# BFF Service Environment Variables
# Copy this file to .env.local or .env and update values as needed

# Application Configuration
PORT=3000
NODE_ENV=development

# User preferred_locale column defaults to en; clients send preferredLocale on signup/login.

# Database seed (pnpm seed:users from repo root). Requires migrations first (pnpm db:migrate).
# Production (content only — no test users):
#   SEED_CONFIRM_PRODUCTION=yes SEED_SKIP_USERS=1 pnpm seed:users
# Dev/staging with test accounts:
#   pnpm seed:users

# Frontend URL (optional in development, required in production)
# Used for password-reset and verification links in transactional email.
# Must match the public web app origin (no trailing slash). Example: https://app.welpco.com
# In development, if not set, automatically allows http://localhost:8080, http://localhost:8081, and http://localhost:3000
FRONTEND_URL=http://localhost:8081

# Email logo URL base (falls back to FRONTEND_URL when unset)
# PUBLIC_APP_URL=http://localhost:8081

# Transactional email (verification, password reset, notifications) — production checklist:
#   1. RESEND_API_KEY          Resend HTTP API (required on Vercel; SMTP ports are blocked)
#                              Also used by admin GET /api/admin/reports/emails (+ /:id preview)
#   2. SMTP_FROM               Verified sender in Resend (e.g. Welpco <updates@updates.welpco.com>)
#   3. FRONTEND_URL            Public web origin so reset/verify links in email are correct
# RESEND_API_KEY=re_YOUR_API_KEY
# SMTP_FROM=Welpco <updates@welpco.com>

# Twilio SMS (transactional notifications)
# ------------------------------------------------------------------
# Local default is stub (logs to BFF console) when TWILIO_* is unset
# or SMS_PROVIDER=stub. Set all three TWILIO_* vars and SMS_PROVIDER=twilio
# for live sends. Users opt out via notification_preferences.sms_enabled
# (default true).
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# SMS_PROVIDER=stub

# SMTP fallback (long-lived hosts only — not Vercel serverless):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_YOUR_API_KEY

# Mailpit (local dev): SMTP_HOST=localhost, SMTP_PORT=1025, omit RESEND_API_KEY
# Mailpit web UI: http://localhost:8025  (started by docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional: comma-separated allowlist (overrides default CORS build). Use in prod for web + admin.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Cloudflare Turnstile — production checklist
#
# Web app (apps/web):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY   public site key (widget)
#   TURNSTILE_SECRET_KEY             POST /api/contact (verified in Next.js, not BFF)
#
# BFF (this service):
#   TURNSTILE_SECRET_KEY             signup, password reset, resend-verification
#
# Set TURNSTILE_SECRET_KEY here in production. Also set both keys on the web app.
# Omit all Turnstile keys locally to skip verification. See apps/web/.env.example.
#
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Database (single backend uses one PostgreSQL database)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=welpco
DB_PASSWORD=welpco_dev
DB_DATABASE=welpco_dev
# SSL: enabled automatically when NODE_ENV=production (sslmode=require).
# Dev against managed Postgres: DB_SSL=true or PGSSLMODE=require
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false

# JWT Configuration (keep JWT_REFRESH_SECRET consistent across restarts or refresh will fail with 401)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Maps Geocoding (reverse: lat/lng → address; forward: postal code → lat/lng)
# Enable "Geocoding API" in Google Cloud Console: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
# Non-empty value required at startup. Use a real Geocoding API key for address features; `local-dev-placeholder` only satisfies boot.
GOOGLE_MAPS_API_KEY=local-dev-placeholder

# Stripe (platform account + Connect Express for welper payouts). Webhook signing secret from Dashboard → Developers → Webhooks
# Welper BG check / Connect return URLs land on /dashboard/setup/background-check and /dashboard/setup/payout (locale prefix when FRONTEND_URL includes /fr).
# Enable Connect in Dashboard → Settings → Connect; use Express accounts for welper onboarding.
# Playwright welper signup sends header x-welpco-signup-e2e: 1 (non-production only) to skip real Stripe/Certn.
# API version is pinned in src/domains/payment/stripe-client.ts (bump with Stripe SDK releases).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_AUTHORIZATION_LEAD_HOURS=72
PAYMENT_AUTHORIZATION_DEADLINE_HOURS=24
PAYMENT_AUTHORIZATION_CAPTURE_BUFFER_HOURS=6
PAYMENT_AUTHORIZATION_MAX_AUTOMATIC_ATTEMPTS=2

# Certn — Canadian criminal record check + identity verification (separate from booking Stripe)
# Docs: https://docs.certn.co/api/certn-api-v-1.0/getting-started/demo-account
#
# Interim flow (until Certn API is enabled on your account): leave CERTN_API_ENABLED unset/false.
# After Stripe payment, BFF emails the welper a Certn screening link (manual flow when API is off).
# French users (preferred_locale fr) receive BACKGROUND_CHECK_APPLICANT_URL_FR when set, else EN URL.
# Dashboard "packages" are optional — the API uses request flags, not package IDs.
#
# BACKGROUND_CHECK_APPLICANT_URL=https://app.certn.co/...  (English — required when API off)
# BACKGROUND_CHECK_APPLICANT_URL_FR=https://app.certn.co/...  (French — optional; falls back to EN URL)
# CERTN_API_ENABLED=false
#
# --- When Certn enables API access ---
# CERTN_API_ENABLED=true
# CERTN_API_KEY=
# CERTN_WEBHOOK_SECRET=https://<your-bff>/api/webhooks/certn
#
# --- Production (Vercel BFF) ---
# • API: https://api.certn.co  (do NOT set demo-api; BFF defaults to api.certn.co when NODE_ENV=production)
# • API key: https://app.certn.co → Settings → Team Settings → API Keys (live key, not demo)
#
# --- Local dev only (optional sandbox) ---
# • API: https://demo-api.certn.co  (default when NODE_ENV≠production and CERTN_API_BASE_URL unset)
# • Demo key: https://demo-app.certn.co/login → Settings → API Keys
#
CERTN_API_KEY=
# Production: omit CERTN_API_BASE_URL (uses https://api.certn.co). Local only:
# CERTN_API_BASE_URL=https://demo-api.certn.co
# CRC requires identity verification on the invite. Default: standard IDV.
# If Certn returns "not permitted to run" standard IDV, try enhanced or contact support@certn.co.
# CERTN_IDENTITY_CHECK_MODE=identity
# CERTN_IDENTITY_CHECK_MODE=enhanced
CERTN_WEBHOOK_SECRET=
BACKGROUND_CHECK_APPLICANT_URL=

# Object storage (profile + portfolio photos, dispute evidence)
# ------------------------------------------------------------------
# Local dev uses MinIO (docker-compose): S3-compatible, no real AWS.
#   API endpoint  http://localhost:9000   console  http://localhost:9001
#   The minio-init container creates bucket `welpco-dev` and grants
#   anonymous read on profiles/ and portfolio/ (mirrors the prod policy).
# S3_ENDPOINT + S3_FORCE_PATH_STYLE switch the SDK to MinIO; S3_PUBLIC_URL
# is the browser-reachable host used to build unsigned display URLs.
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=welpco-dev
AWS_ACCESS_KEY_ID=welpco_minio
AWS_SECRET_ACCESS_KEY=welpco_minio_dev
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000
#
# Production (real AWS S3): set AWS_S3_REGION + AWS_S3_BUCKET, use IAM-role
# credentials (omit AWS_ACCESS_KEY_ID/SECRET on IRSA/instance roles), and
# LEAVE S3_ENDPOINT / S3_FORCE_PATH_STYLE / S3_PUBLIC_URL UNSET so URLs use
# the AWS virtual-hosted form (https://{bucket}.s3.{region}.amazonaws.com/…).
BACKGROUND_CHECK_APPLICANT_URL_FR=

# Vercel Web Analytics (admin marketing report)
# ------------------------------------------------------------------
# Powers GET /api/admin/reports/web-analytics. Requires Web Analytics
# enabled on the apps/web Vercel project and a token that can read it.
# Create a token: Vercel Dashboard → Account/Team Settings → Tokens.
# Find projectId / teamId: Project Settings → General, or `vercel project ls`.
# Leave unset in local dev — the report returns 503 until configured.
# VERCEL_TOKEN=
# VERCEL_WEB_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...
# Alternative to team id (use one): VERCEL_TEAM_SLUG=your-team-slug
