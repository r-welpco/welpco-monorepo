# BFF Service Environment Variables
# Copy this file to .env.local or .env and update values as needed

# Application Configuration
PORT=3000
NODE_ENV=development

# User preferred_locale column defaults to en; clients send preferredLocale on signup/login.

# Launch gate (global): when true (default), all signed-up users are blocked from /dashboard
# and land on /register/complete. Set false to open the dashboard for everyone.
# Mirror the same value on the web app (PLATFORM_ACCESS_GATED + NEXT_PUBLIC_PLATFORM_ACCESS_GATED).
# PLATFORM_ACCESS_GATED=true

# Database seed (pnpm seed:users from repo root). Requires migrations first (pnpm db:migrate).
# Production (content only — no test users):
#   SEED_CONFIRM_PRODUCTION=yes SEED_SKIP_USERS=1 pnpm seed:users
# Dev/staging with test accounts:
#   pnpm seed:users

# Frontend URL (optional in development, required in production)
# In development, if not set, automatically allows http://localhost:8080, http://localhost:8081, and http://localhost:3000
FRONTEND_URL=http://localhost:8081

# Email logo URL base (falls back to FRONTEND_URL when unset)
# PUBLIC_APP_URL=http://localhost:8081

# SMTP — Resend in production, MailHog locally (docker-compose mailhog service)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_FROM=noreply@welpco.com
# SMTP_USER=resend
# SMTP_PASS=re_YOUR_API_KEY
# Legacy alias: SMTP_PASSWORD (used if SMTP_PASS is unset)

# MailHog (local dev): SMTP_HOST=localhost, SMTP_PORT=1025, omit USER/PASS
# MailHog web UI: http://localhost:8025
# Optional: comma-separated allowlist (overrides default CORS build). Use in prod for web + admin.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Database (single backend uses one PostgreSQL database)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=welpco
DB_PASSWORD=welpco_dev
DB_DATABASE=welpco_dev

# JWT Configuration (keep JWT_REFRESH_SECRET consistent across restarts or refresh will fail with 401)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Maps Geocoding (reverse: lat/lng → address; forward: postal code → lat/lng)
# Enable "Geocoding API" in Google Cloud Console: https://console.cloud.google.com/apis/library/geocoding-backend.googleapis.com
# Non-empty value required at startup. Use a real Geocoding API key for address features; `local-dev-placeholder` only satisfies boot.
GOOGLE_MAPS_API_KEY=local-dev-placeholder

# Stripe (platform account + Connect Express for welper payouts). Webhook signing secret from Dashboard → Developers → Webhooks
# Enable Connect in Dashboard → Settings → Connect; use Express accounts for welper onboarding.
# Playwright welper signup sends header x-welpco-signup-e2e: 1 (non-production only) to skip real Stripe/Certn.
# API version is pinned in src/domains/payment/stripe-client.ts (bump with Stripe SDK releases).
STRIPE_SECRET_KEY=sk_test_51TGV7mJoPWRkRUdIMK9uMIYgvvi5kcCkNZ0iall3lkpXA6wgD8lUVxjeoICJTZJIxPLgkD1QXNfnW2wC1a4tZjcY00OmIbBGtJ
STRIPE_WEBHOOK_SECRET=whsec_e7cf14fd997465a54d75667c979dabfcd07561b0fb6ba7aba71fe1f4788b0db5

# Certn — Basic Canadian criminal record check only (isolated from booking Stripe)
# Docs: https://docs.certn.co/api/certn-api-v-1.0/getting-started/demo-account
#
# Full-flow testing on Certn demo (sandbox):
# 1. Create demo org: https://demo-app.certn.co/welcome/signUp
# 2. API key: https://demo-app.certn.co/login → Settings → Team Settings → API Keys
# 3. Optional: add test card 4242…4242 in Billing (unlocks more demo features)
# 4. Set CERTN_API_KEY below (do NOT leave unset — stub mode links to /login, not a real invite)
# 5. Webhook: Certn dashboard → point to https://<tunnel>/api/webhooks/certn
#    Use the signing secret as CERTN_WEBHOOK_SECRET (or test pass/fail via retry-invite + manual DB)
# 6. BFF uses demo-api.certn.co in development; production uses api.certn.co
#
# Demo returns mock/prefilled results — exercises Welpco wiring, not a live CPIC check.
# In development, CERTN_API_BASE_URL defaults to https://demo-api.certn.co when unset.
CERTN_API_KEY=2480e1dd61f34f16c52f6e2f58f6030779e43981
# CERTN_API_BASE_URL=https://demo-api.certn.co
CERTN_WEBHOOK_SECRET=529759a9d39906e6e29220c394ebd597230e00e8df91d3afdd66db328c1ee175
# Certn invite uses POST /hr/v1/applications/invite/ — applicants usually complete via email link,
# not the employer dashboard at demo-app.certn.co/login.
