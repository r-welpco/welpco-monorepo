{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@welpco/(.*)$": "<rootDir>/../../../packages/$1/src",
    "^(\\.\\./){3,4}common/(.*)$": "<rootDir>/../src/common/$2"
  },
  "setupFilesAfterEnv": ["<rootDir>/jest-e2e.setup.ts"]
}
