{
  "name": "@welpco/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8081",
    "build": "next build",
    "start": "next start -p 8081",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
    "test:e2e:personalization": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test e2e/personalization/personalization.spec.ts --reporter=list",
    "test:e2e:profile": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test e2e/profile/",
    "test:e2e:auth": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --grep '@auth'",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/themes": "3.3.0",
    "@stripe/react-stripe-js": "^6.0.0",
    "@stripe/stripe-js": "^9.0.0",
    "@tanstack/react-query": "^5.62.11",
    "@welpco/types": "workspace:*",
    "@welpco/ui": "workspace:*",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "libphonenumber-js": "^1.11.20",
    "lucide-react": "^0.468.0",
    "next": "16.2.3",
    "next-auth": "^5.0.0-beta.25",
    "next-mdx-remote": "^6.0.0",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.54.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "clsx": "^2.1.1",
    "esbuild": "^0.27.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "typescript": "^5"
  }
}
