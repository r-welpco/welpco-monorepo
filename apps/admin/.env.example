# Welpco Admin — copy to .env.local for local development
# .env.local is gitignored

# ============================================
# Required for production
# ============================================

# BFF API base URL (browser + server-side admin API calls)
NEXT_PUBLIC_API_URL=http://localhost:3000

# NextAuth — session signing (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-in-production

# Canonical URL of this admin app (required in production)
# Local dev default port: 8082
NEXTAUTH_URL=http://localhost:8082

# Auth.js v5 also accepts AUTH_SECRET / AUTH_URL as aliases of the above.

# ============================================
# Admin maps (welper distribution report)
# ============================================

# OSM public tiles are fine for development/light admin usage. Configure a
# production tile provider here if admin map usage grows.
NEXT_PUBLIC_ADMIN_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_ADMIN_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# ============================================
# BFF coordination (set on BFF, not admin)
# ============================================

# Production: add this admin origin to BFF CORS_ORIGINS, e.g.:
# CORS_ORIGINS=https://admin.example.com,https://app.example.com
